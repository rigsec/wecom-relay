# callback token from WeCom admin console
WECOM_TOKEN=
# 43-char AES key from WeCom admin console
WECOM_ENCODING_AES_KEY=
# enterprise corp ID
WECOM_CORP_ID=ww...
# shared secret for the /relay/* endpoints
# generate with: openssl rand -hex 32
RELAY_API_SECRET=
RESPONSE_TTL_SECONDS=86400

# Optional: immediate card-disable after button click
# When both are set, the relay calls interactive/taskcard/update right after
# storing a response so buttons become un-clickable before SOARAI replies.
# Corp secret from WeCom admin console → My Enterprise → App Management → [App] → Secret
WECOM_CORP_SECRET=
# Agent ID from WeCom admin console → App Management → [App]
WECOM_AGENT_ID=
